<?xml version="1.0" encoding="utf-8"?>
<wpf:BaseViewModelWindow x:Class="Cognex.InSight.Liger.Emulator.ConfigureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Cognex.Foundations.Wpf.Common;assembly=Cognex.Foundations.Wpf" xmlns:controls="clr-namespace:Cognex.Foundations.Wpf.Controls;assembly=Cognex.Foundations.Wpf" xmlns:converters="clr-namespace:Cognex.Foundations.Wpf.Converters;assembly=Cognex.Foundations.Wpf" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:properties="clr-namespace:Cognex.InSight.Liger.Emulator.Properties" xmlns:utility="clr-namespace:Cognex.InSight.Liger.Emulator" xmlns:wpf="clr-namespace:Cognex.Mvvm.Wpf;assembly=Cognex.Foundations.Wpf" xmlns:xaml="clr-namespace:Cognex.Foundations.Wpf.Xaml;assembly=Cognex.Foundations.Wpf" xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit" xmlns:primitives="http://schemas.xceed.com/wpf/xaml/toolkit" Title="{x:Static properties:Resources.UtilityAppTitle}" Width="Auto" Height="Auto" MinWidth="375" MaxWidth="650" Icon="appicon.ico" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Style="{StaticResource StandardWindow}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cognex.Foundations.Wpf;component/Windows/Common.xaml" />
        <ResourceDictionary Source="NumericUpDownStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
      <converters:BooleanToVisibilityConverter x:Key="InvertedVisibilityConverter" False="Visible" True="Collapsed" />
      <Style x:Key="{x:Type xctk:DecimalUpDown}" TargetType="{x:Type xctk:DecimalUpDown}" BasedOn="{StaticResource NumericUpDown}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="root">
    <Grid Margin="10,5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="4" AutomationProperties.AutomationId="{x:Static utility:ConfigureWindow.EditingConfig}" Text="{Binding Configuration}" />
      <Grid Name="EmulatedCameras" Row="1" Column="0" ColumnSpan="2" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="CamTemplate" DataType="{x:Type utility:AcquisionUnitViewModel}">
              <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Width="Auto" Margin="5,0,5,0" HorizontalAlignment="Stretch" IsEnabled="{Binding IsEnabled}" Text="{Binding Directory}" AutomationProperties.AutomationId="{Binding Path=Id, StringFormat=AID_Directory_{0}}" />
                <Button Grid.Column="1" Width="Auto" Height="Auto" Margin="0,0,10,0" Padding="6,0,6,0" HorizontalAlignment="Left" Content="..." Visibility="Visible" Command="{Binding SelectFolderCmd}" IsEnabled="{Binding IsEnabled}" AutomationProperties.AutomationId="{Binding Path=Id, StringFormat=AID_Browse_{0}}" />
              </Grid>
            </DataTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid Margin="8,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="2" Text="{x:Static properties:Resources.AssignImageDirectories}" />
          <ItemsControl Grid.Row="1" Grid.Column="0" Margin="5,2,2,2" ItemTemplate="{StaticResource CamTemplate}" ItemsSource="{Binding CameraInfoList}" />
        </Grid>
      </Grid>
      <controls:OkayCancelPanel Grid.Row="2" Grid.Column="1">
        <i:Interaction.Behaviors>
          <xaml:SimpleCommandBinding RoutedCommand="{x:Static common:AppCommands.CloseWithAcceptResult}" TargetCommand="{Binding PrimaryOperationCommand}" />
          <xaml:SimpleCommandBinding RoutedCommand="{x:Static common:AppCommands.CloseWithRejectResult}" TargetCommand="{Binding RejectCommand}" />
        </i:Interaction.Behaviors>
      </controls:OkayCancelPanel>
    </Grid>
  </Grid>
</wpf:BaseViewModelWindow>